<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_vtiger_company_form" model="ir.ui.view">
        <field name="name">res.company.vtiger.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="vtiger_configuration" string="VTiger Configuration">
                    <group col="4" name="vtiger_details">
                        <field name="access_key" placeholder="Enter Access Key" />
                        <field name="vtiger_server" placeholder="https://example.com" />
                        <field name="user_name" placeholder="example@test.com" />
                        <field name="last_sync_date" />
                    </group>
                    <separator string="Sync Progress (VTiger to Odoo)" />
                    <group
                        name="vtiger_sync_progress_controls"
                        col="6"
                        class="o_vtiger_progress_controls"
                    >
                        <button
                            name="action_check_vtiger_sync_progress"
                            string="Check Sync Progress"
                            type="object"
                            class="vtiger_button vtiger_progress_button"
                        />
                        <label for="vtiger_progress_from_date" />
                        <field name="vtiger_progress_from_date" nolabel="1" />
                        <label for="last_vtiger_progress_check" />
                        <field
                            name="last_vtiger_progress_check"
                            nolabel="1"
                            readonly="1"
                        />
                    </group>
                    <group
                        name="vtiger_sync_dashboard"
                        col="1"
                        class="o_vtiger_sync_dashboard"
                    >
                        <separator
                            string="Master Data Synchronisation (VTiger to Odoo)"
                        />
                        <group
                            col="1"
                            name="vtiger_master_sync"
                            class="o_vtiger_sync_table"
                        >
                            <group
                                name="vtiger_all_master_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <button
                                    name="action_sync_vtiger_master_data"
                                    string="Sync All Master Data"
                                    type="object"
                                    class="vtiger_button"
                                />
                                <div class="o_vtiger_empty_progress" />
                            </group>
                            <group
                                name="vtiger_partner_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_partner_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_product_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_product_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_pricebook_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_pricebook_progress"
                                    widget="progressbar"
                                />
                            </group>
                        </group>
                        <separator
                            string="Transactional Data Synchronisation (VTiger to Odoo)"
                        />
                        <group
                            col="1"
                            name="vtiger_transactional_sync"
                            class="o_vtiger_sync_table"
                        >
                            <group
                                name="vtiger_all_transactional_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <button
                                    name="action_sync_vtiger_transactional_data"
                                    string="Sync All Transactional Data"
                                    type="object"
                                    class="vtiger_button"
                                />
                                <div class="o_vtiger_empty_progress" />
                            </group>
                            <group
                                name="vtiger_crm_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_crm_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_calendar_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_calendar_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_document_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_document_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_helpdesk_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_helpdesk_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_invoice_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_invoice_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_project_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_project_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_purchase_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_purchase_progress"
                                    widget="progressbar"
                                />
                            </group>
                            <group
                                name="vtiger_sale_sync_row"
                                col="2"
                                class="o_vtiger_sync_row"
                            >
                                <field
                                    name="vtiger_sale_progress"
                                    widget="progressbar"
                                />
                            </group>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
