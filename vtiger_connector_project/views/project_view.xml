<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_vtiger_project_project_form" model="ir.ui.view">
        <field name="name">project.project.vtiger.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <!-- <xpath expr ="//div[@name='options_active']" position ="after"> -->
            <xpath expr="//sheet/div[2]" position="after">
                <div name="vtiger">
                    <group>
                        <field name="vtiger_id" />
                    </group>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_vtiger_project_project_search" model="ir.ui.view">
        <field name="name">project.project.vtiger.search</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vtiger_id" />
            </field>
            <filter name="Manager" position="after">
                <filter
                    string="Synced From Vtiger"
                    name="vtiger"
                    domain="[('vtiger_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>

    <record id="view_vtiger_project_task_form" model="ir.ui.view">
        <field name="name">project.task.vtiger.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='partner_id'])[1]" position="after">
                <field name="vtiger_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="view_vtiger_project_task_search" model="ir.ui.view">
        <field name="name">project.task.vtiger.search</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vtiger_id" />
            </field>
            <filter name="my_tasks" position="after">
                <filter
                    string="Synced From Vtiger"
                    name="vtiger"
                    domain="[('vtiger_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>

</odoo>
