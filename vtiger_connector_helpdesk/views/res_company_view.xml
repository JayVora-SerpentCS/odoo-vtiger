        <field name="model">res.company</field>
        <field name="inherit_id" ref="vtiger_connector_base.view_vtiger_company_form" />
        <field name="arch" type="xml">
            <field name="vtiger_helpdesk_progress" position="before">
                <button
                    name="sync_vtiger_helpdesk_ticket"
