<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_vtiger_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.vtiger.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <!-- Field-based xpath (stable across versions) instead of a
                 CSS-class based structural xpath, which is fragile and can
                 break silently if the parent view's markup/classes change
                 between Odoo releases. "name" is the calendar event's core
                 subject field and is expected to remain present. -->
            <field name="name" position="after">
                <group>
                    <field name="vtiger_id" />
                </group>
            </field>
        </field>
    </record>

    <record id="view_vtiger_calendar_event_search" model="ir.ui.view">
        <field name="name">calendar.event.vtiger.search</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vtiger_id" />
            </field>
            <filter name="mymeetings" position="after">
                <filter
                    string="Synced From Vtiger"
                    name="vtiger"
                    domain="[('vtiger_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>

</odoo>
