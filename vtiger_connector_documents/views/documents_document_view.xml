<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_vtiger_dms_file_form" model="ir.ui.view">
        <field name="name">dms.file.vtiger.form</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='page_meta']" position="after">
                <page string="VTiger">
                    <group>
                        <field name="vtiger_id" readonly="1" />
                        <field name="vtiger_document_no" readonly="1" />
                        <field name="vtiger_filename" readonly="1" />
                        <field name="vtiger_filesize" readonly="1" />
                        <field name="vtiger_filetype" readonly="1" />
                        <field name="vtiger_folder_id" readonly="1" />
                        <field name="vtiger_document_source" readonly="1" />
                        <field name="vtiger_document_type" readonly="1" />
                        <field name="vtiger_createdtime" readonly="1" />
                        <field name="vtiger_modifiedtime" readonly="1" />
                        <field name="vtiger_notecontent" readonly="1" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_vtiger_dms_file_search" model="ir.ui.view">
        <field name="name">dms.file.vtiger.search</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.search_dms_file" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vtiger_id" />
                <field name="vtiger_document_no" />
            </field>
            <filter name="filter_active" position="after">
                <filter
                    string="Synced From Vtiger"
                    name="vtiger"
                    domain="[('vtiger_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>

</odoo>
